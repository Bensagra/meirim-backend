generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"      // o “mysql” / “sqlite”
  url      = env("DATABASE_URL")
}

/// Estados posibles de una actividad
enum EstadoActividad {
  NO_HAY_NADIE                      // Estado1: No hay nadie para planificar
  HAY_GENTE_PERO_NO_NECESARIA       // Estado2: Tiene gente para planificar pero no la necesaria
  YA_HAY_GENTE_PERO_NO_SE_PLANIFICO // Estado3: Ya está la gente pero no se planificó
  FUE_PLANIFICADA                   // Estado4: Fue planificada
  FUE_DADA_LA_PLANIFICACION         // Estado5: Fue dada la planificación
}

/// Resultado de un enfrentamiento de la Mesaza
enum MesazaWinner {
  A
  B
  TIE
}

/// Galerías públicas del sitio
enum GalleryScope {
  HOME
  MESAZA
}

/// Roles / estatus de acceso de cada usuario
enum Role {
  MIEMBRO            // Acceso base: planificar, votar, jugar, ver su perfil
  EDITOR_FOTOS       // Puede subir y ordenar las galerías
  ADMIN_ACTIVIDADES  // Gestiona actividades, temáticas, mesaza, nominaciones, 100M
  SUPER_ADMIN        // Acceso total + gestión de usuarios y roles
}

/// Usuarios de la aplicación
model User {
  id           Int             @id @default(autoincrement())
  name         String
  surname      String
  dni          String          @unique
  email        String          @unique
  password     String?         // hash bcrypt; null = cuenta sin reclamar (legacy)
  roles        Role[]          @default([MIEMBRO]) // todos son MIEMBRO + roles extra
  photoUrl     String?         // foto única del usuario (avatar = foto en Mesaza)
  // Perfil personalizable
  nickname     String?
  bio          String?
  accentColor  String?         // color de acento elegido por el usuario (#hex)
  instagram    String?
  phone        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  actividades  ActivityUser[]  // relaciones a actividades

  mesazaAsA    MesazaMatch[]    @relation("MesazaCompetitorA")
  mesazaAsB    MesazaMatch[]    @relation("MesazaCompetitorB")

  disponibilidadHorarios DisponibilidadHorarios[]
  asistencias  Asistencia[]
}

/// Temáticas publicadas anónimamente
model Tematica {
  id           Int                   @id @default(autoincrement())
  tematica     String
  usada        Boolean               @default(false)
  createdAt   DateTime              @default(now())
  actividades  ActivityTematica[]    // relaciones a actividades
}

/// Día de planificación con su estado y temáticas
model Activity {
  id             Int                   @id @default(autoincrement())
  fecha          DateTime              @unique     // Fecha de la actividad
  estado         EstadoActividad       @default(NO_HAY_NADIE)
  participants   ActivityUser[]        // usuarios que realizan la actividad
  tematicas      ActivityTematica[]    // temáticas asociadas a la actividad
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  notas          String?               // Notas opcionales sobre la actividad
  blocked       Boolean               @default(false)
  asistencias    Asistencia[]          // confirmaciones de asistencia (RSVP)
}

/// Tabla de unión para asociar usuarios a una actividad
model ActivityUser {
  activity    Activity   @relation(fields: [activityId], references: [id])
  activityId  Int

  user        User       @relation(fields: [userId], references: [id])
  userId      Int

  @@id([activityId, userId])
}

/// Tabla de unión para asociar temáticas a una actividad
model ActivityTematica {
  activity     Activity   @relation(fields: [activityId], references: [id])
  activityId   Int

  tematica     Tematica   @relation(fields: [tematicaId], references: [id])
  tematicaId   Int

  @@id([activityId, tematicaId])
}



model DisponibilidadHorarios {
  id      Int    @id @default(autoincrement())
  user    User   @relation(fields: [userId], references: [id])
  userId  Int
  dia     String
  horario String

  @@unique([userId, dia, horario])
}

model PenpalLead {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String
  idioma    String
  createdAt DateTime @default(now())

  @@unique([email, idioma])
}

model ShopNotify {
  id          Int      @id @default(autoincrement())
  email       String
  preferencia String
  createdAt   DateTime @default(now())

  @@index([email])
}

/// Categorías de nominaciones para el campamento
model CategoriaNominacion {
  id           Int           @id @default(autoincrement())
  nombre       String        @unique
  descripcion  String?
  orden        Int           @default(0)
  activa       Boolean       @default(true)
  nominaciones Nominacion[]
}

/// Campistas que pueden ser nominados
model Campista {
  id           Int           @id @default(autoincrement())
  nombre       String        @unique
  nominaciones Nominacion[]
}

/// Votos de nominaciones
model Nominacion {
  id          Int                    @id @default(autoincrement())
  categoria   CategoriaNominacion    @relation(fields: [categoriaId], references: [id])
  categoriaId Int
  campista    Campista               @relation(fields: [campistaId], references: [id])
  campistaId  Int
  votante     String                 // DNI o identificador del votante
  createdAt   DateTime               @default(now())

  @@unique([categoriaId, votante])
  @@index([categoriaId])
  @@index([campistaId])
}

/// Preguntas para "100 Meirimers Dicen" - ahora con opciones predefinidas para ordenar
model Pregunta100 {
  id          Int                @id @default(autoincrement())
  pregunta    String
  orden       Int                @default(0)
  activa      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  opciones    Opcion100[]
  
  @@index([activa])
}

/// Opciones de cada pregunta con su posición correcta y cantidad de "votos"
model Opcion100 {
  id          Int          @id @default(autoincrement())
  pregunta    Pregunta100  @relation(fields: [preguntaId], references: [id], onDelete: Cascade)
  preguntaId  Int
  texto       String       // Texto de la opción
  posicion    Int          // Posición correcta (1 = más votado, 2 = segundo, etc.)
  cantidad    Int          // Cantidad de "personas" que lo dijeron
  
  @@index([preguntaId])
}

/// Enfrentamientos de la Mesaza
model MesazaMatch {
  id           Int            @id @default(autoincrement())
  title        String?
  description  String?
  date         DateTime
  competitorA  User           @relation("MesazaCompetitorA", fields: [competitorAId], references: [id])
  competitorAId Int
  competitorB  User           @relation("MesazaCompetitorB", fields: [competitorBId], references: [id])
  competitorBId Int
  winner       MesazaWinner?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  photos       MesazaPhoto[]

  @@index([date])
}

/// Fotos extra de cada enfrentamiento
model MesazaPhoto {
  id        Int         @id @default(autoincrement())
  url       String
  caption   String?
  match     MesazaMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId   Int
  createdAt DateTime    @default(now())

  @@index([matchId])
}

/// Fotos sueltas para galerías públicas
model GalleryPhoto {
  id        Int          @id @default(autoincrement())
  scope     GalleryScope
  url       String
  caption   String?
  displayOrder Int       @default(0)
  createdAt DateTime     @default(now())

  @@index([scope, displayOrder])
  @@index([scope, createdAt])
}

/// Noticias del chapter (flyers, textos e indicaciones). Las sube EDITOR_FOTOS.
model Noticia {
  id        Int      @id @default(autoincrement())
  titulo    String
  cuerpo    String?  // texto / indicaciones (opcional si es solo un flyer)
  imageUrl  String?  // flyer subido a Supabase Storage (opcional)
  pinned    Boolean  @default(false) // destacada: va arriba de todo
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pinned, createdAt])
}

/// Suscripción a notificaciones push (Web Push). No usa websockets.
model PushSubscription {
  id        Int      @id @default(autoincrement())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    Int?     // opcional: si el dispositivo está logueado
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Respuesta de asistencia (RSVP) de un miembro a una actividad.
enum EstadoAsistencia {
  VOY
  TAL_VEZ
  NO_VOY
}

/// Confirmación de asistencia de un miembro a una actividad.
model Asistencia {
  id         Int              @id @default(autoincrement())
  activity   Activity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  activityId Int
  user       User             @relation(fields: [userId], references: [id])
  userId     Int
  estado     EstadoAsistencia
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([activityId, userId])
  @@index([activityId])
}

/// Productos de la Tienda Meiru (vidriera: se muestran, no se venden online).
model Producto {
  id           Int      @id @default(autoincrement())
  nombre       String
  descripcion  String?
  precio       String?  // texto libre: "$8.000", "Consultar", etc.
  imageUrl     String?  // foto del producto (Supabase Storage)
  talles       String?  // texto libre: "S, M, L, XL"
  displayOrder Int      @default(0)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([activo, displayOrder])
}
